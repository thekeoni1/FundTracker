# Copy this file to .env and fill in real values. .env is gitignored.

# Required. SEC policy: a name or company and a contact email, separated by a space.
FUNDTRACKER_USER_AGENT=Your Name your.email@example.com

# Optional. Defaults shown.
# FUNDTRACKER_DATA_DIR=data
#   Database, raw XML cache and data set zips. Point it outside a synced folder
#   such as OneDrive, e.g. FUNDTRACKER_DATA_DIR=C:\Users\you\FundTrackerData
# FUNDTRACKER_EXPORT_DIR=data/exports
#   Workbooks and CSVs written by new and emerging; stays in the project by default.
# FUNDTRACKER_RATE_LIMIT_PER_SEC=5
